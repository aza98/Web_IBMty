# Text files use LF; images, fonts and archives are binary.
* text=auto eol=lf
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.gz binary
*.zip binary

# Vendored originals must stay byte-identical. Exempt them from whitespace
# checks so `git diff --check` reports only the project's own source.
vendor/** -whitespace
vendor/** -text
